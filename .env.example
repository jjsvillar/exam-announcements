# Bind to all local network interfaces. Use 127.0.0.1 for this computer only.
HOST=0.0.0.0
PORT=3000
# Set this to the exact browser URL, including the port.
# For LAN use, replace localhost with this computer's LAN IP and use that URL
# for both the exam display and /admin. This also permits same-origin uploads.
ORIGIN=http://localhost:3000
# Allow background image/audio/video requests larger than the 512K Node default.
BODY_SIZE_LIMIT=50M
